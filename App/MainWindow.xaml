<Window x:Class="ScreenTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ScreenTranslator"
        xmlns:vm="clr-namespace:ScreenTranslator.ViewModels"
        xmlns:views="clr-namespace:ScreenTranslator.Views"
        Title="屏幕翻译器" Icon="pack://application:,,,/Assets/ScreenTranslator.ico" Width="760" Height="520" MinWidth="620" MinHeight="460"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Canvas}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource BodyFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <local:DocumentViewportHeightConverter x:Key="DocumentViewportHeightConverter"/>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LanguagePackViewModel}"><views:LanguagePackView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentViewModel}"><views:DocumentView Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource DocumentViewportHeightConverter}}"/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RecognitionViewModel}"><views:RecognitionView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PageViewModel}"><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/></DataTemplate>
        <Style x:Key="CompactNavItem" TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Padding" Value="10,9"/>
        </Style>
        <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1,0"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,0,0,1" Padding="13,0,9,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource Accent}" Margin="0,0,9,0">
                            <TextBlock Text="A/文" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Surface}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="屏幕翻译器" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource StatusCapsule}" Padding="9,5" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" FontSize="9" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding StateLabel}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource TitleBarButton}" Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="最小化">
                            <TextBlock Text="&#xE921;" Style="{StaticResource Icon}" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="最大化或还原">
                            <TextBlock Text="&#xE922;" Style="{StaticResource Icon}" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource TitleBarButton}" Command="{x:Static SystemCommands.CloseWindowCommand}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="关闭">
                            <TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="154"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}"
                             BorderThickness="0" Background="{StaticResource TransparentBrush}"
                             ItemContainerStyle="{StaticResource CompactNavItem}"
                             AutomationProperties.AutomationId="Navigation">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="16" Margin="0,0,9,0"/>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="13,11,13,13" CanContentScroll="False" ClipToBounds="True">
                    <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}"
                                    HorizontalContentAlignment="Stretch" ClipToBounds="True"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
