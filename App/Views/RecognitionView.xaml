<UserControl x:Class="ScreenTranslator.Views.RecognitionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="实时识别" Style="{StaticResource SectionTitle}" FontSize="20"/>
                <TextBlock Text="控制屏幕识别并查看实时状态" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource CardStyle}" Padding="13" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="当前显示器" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                <ComboBox x:Name="MonitorPicker" ItemsSource="{Binding Capture.Monitors}"
                          SelectedItem="{Binding Capture.SelectedMonitor}" DisplayMemberPath="DisplayLabel"
                          IsEnabled="{Binding Capture.CanSelectMonitor}" AutomationProperties.AutomationId="MonitorPicker"/>
                <WrapPanel Margin="0,9,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Padding="13,8" Margin="0,0,6,0"
                            Command="{Binding Capture.StartCommand}" AutomationProperties.AutomationId="StartCapture">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Capture.StartLabel}"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="12,8" Margin="0,0,6,0" Command="{Binding Capture.PauseCommand}" AutomationProperties.AutomationId="Pause">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE769;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="暂停 / 继续"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Padding="12,8" Command="{Binding Capture.StopCommand}" AutomationProperties.AutomationId="Stop">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="停止"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
            <UniformGrid Columns="2">
                <StackPanel Margin="2,2,8,8"><TextBlock Text="识别状态 · English → 中文" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Capture.StateLabel}" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Margin="2,2,2,8"><TextBlock Text="翻译状态" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Capture.ActiveTranslationStatus}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Capture.ActiveTranslationStatus}"/></StackPanel>
                <StackPanel Margin="2,2,8,2"><TextBlock Text="帧率 · FPS" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Capture.FpsText}" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Margin="2,2,2,2"><TextBlock Text="捕获分辨率" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Capture.ResolutionValue}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
            </UniformGrid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel Margin="0,0,0,5">
                    <TextBlock Text="最近识别结果" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Capture.LatestRecognitionSummary}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Capture.TranslatedBlocks}" MaxHeight="180">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source.OriginalText}" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                                    <TextBox Text="{Binding TranslatedText}" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="90"
                                             Padding="3" BorderThickness="0" Background="{StaticResource Canvas}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Expander Header="高级信息" IsExpanded="False"
                  Visibility="{Binding Capture.DebugMode, Converter={StaticResource BoolVisibility}}"
                  Foreground="{StaticResource Muted}">
            <Border Style="{StaticResource CardStyle}" Margin="0,7,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="{Binding Capture.VisionDebugInfo}" Visibility="{Binding Capture.ShowWindowInformation, Converter={StaticResource BoolVisibility}}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Capture.StatusText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="FPS 统计实际新帧；静止画面可能降低。详细诊断可在设置中查看日志。" Style="{StaticResource Caption}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </Expander>
    </StackPanel>
</UserControl>
