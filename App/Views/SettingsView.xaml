<UserControl x:Class="ScreenTranslator.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ScreenTranslator">
 <StackPanel>
  <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
  <TextBlock Text="按照你的习惯，安排每一次专注。" Style="{StaticResource BodyMuted}" Margin="0,0,0,24"/>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <Border Style="{StaticResource CardStyle}">
    <StackPanel>
     <TextBlock Text="常规" Style="{StaticResource SectionTitle}" Margin="0,0,0,20"/>
     <DockPanel Margin="0,0,0,16"><TextBlock Text="开机启动"/><CheckBox Style="{StaticResource OffToggle}" HorizontalAlignment="Right"/></DockPanel>
     <DockPanel Margin="0,0,0,16"><TextBlock Text="启动时自动识别"/><CheckBox Style="{StaticResource OffToggle}" IsChecked="{Binding Capture.AutoStart, Mode=OneWay}" HorizontalAlignment="Right"/></DockPanel>
     <DockPanel><TextBlock Text="主题"/><TextBlock Text="浅色" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel>
     <TextBlock Text="应用启动后始终待机，仅在你点击开始后读取屏幕。" Style="{StaticResource Caption}" Margin="0,20,0,0"/>
    </StackPanel>
   </Border>

   <Border Grid.Column="2" Style="{StaticResource CardStyle}">
    <StackPanel>
     <TextBlock Text="隐私" Style="{StaticResource SectionTitle}" Margin="0,0,0,20"/>
     <TextBlock Text="✓  屏幕捕获和 OCR 在本机完成" Foreground="{StaticResource Success}" Margin="0,0,0,12"/>
     <TextBlock Text="✓  仅向所选翻译服务发送 OCR 文字" Foreground="{StaticResource Success}" Margin="0,0,0,12"/>
     <TextBlock Text="✓  不上传截图和文档区域图片" Foreground="{StaticResource Success}" Margin="0,0,0,12"/>
     <TextBlock Text="✓  API Key 使用 Windows 凭据管理器保存" Foreground="{StaticResource Success}"/>
     <TextBlock Text="只有手动开始识别并检测到英文后才会请求在线翻译。" Style="{StaticResource Caption}" Margin="0,20,0,0"/>
    </StackPanel>
   </Border>

   <Border Grid.Row="2" Style="{StaticResource CardStyle}">
    <StackPanel>
     <TextBlock Text="识别" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/>
     <TextBlock Text="显示器" Style="{StaticResource Caption}" Margin="0,0,0,7"/>
     <ComboBox ItemsSource="{Binding Capture.Monitors}" SelectedItem="{Binding Capture.SelectedMonitor}" DisplayMemberPath="DisplayLabel" IsEnabled="{Binding Capture.CanSelectMonitor}" FontSize="12"/>
     <TextBlock Text="自动选择 · 即将支持。请在停止识别后切换显示器。" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
    </StackPanel>
   </Border>

   <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}">
    <StackPanel>
     <DockPanel Margin="0,0,0,18"><TextBlock Text="显示" Style="{StaticResource SectionTitle}"/><TextBlock Text="{Binding Capture.DisplayModeLabel}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel>
     <WrapPanel Margin="0,0,0,12"><RadioButton Content="中文覆盖" IsChecked="{Binding Capture.IsChineseOverlay}" Margin="0,0,12,0"/><RadioButton Content="中英对照" IsChecked="{Binding Capture.IsBilingual}" Margin="0,0,12,0"/><RadioButton Content="侧边栏" IsChecked="{Binding Capture.IsSidebar}"/></WrapPanel>
     <TextBlock Text="中文背景透明度"/><Slider Value="{Binding Capture.TranslationBackgroundOpacity}" Minimum="0.15" Maximum="1" Margin="0,8,0,12"/>
     <TextBlock Text="字体缩放"/><Slider Value="{Binding Capture.TranslationFontScale}" Minimum="0.65" Maximum="1.8" Margin="0,8,0,10"/>
     <CheckBox Content="中英对照时显示英文原文" IsChecked="{Binding Capture.OriginalTextVisibility}"/>
    </StackPanel>
   </Border>

   <Border Grid.Row="4" Style="{StaticResource CardStyle}">
    <StackPanel>
     <TextBlock Text="性能" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/>
     <DockPanel Margin="0,0,0,12"><TextBlock Text="推理设备" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Capture.InferenceDevices}" SelectedItem="{Binding Capture.SelectedInferenceDevice}" IsEnabled="{Binding Capture.CanSelectMonitor}" Width="110" HorizontalAlignment="Right"/></DockPanel>
     <DockPanel><TextBlock Text="目标 FPS" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding Capture.AvailableFrameRates}" SelectedItem="{Binding Capture.TargetFps}" IsEnabled="{Binding Capture.CanSelectMonitor}" Width="110" HorizontalAlignment="Right"/></DockPanel>
     <TextBlock Text="PaddleOCR 在本机识别；页面稳定后仅请求一次所选在线翻译服务。" Style="{StaticResource Caption}" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>

   <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource CardStyle}">
    <StackPanel>
     <DockPanel Margin="0,0,0,14"><TextBlock Text="在线翻译" Style="{StaticResource SectionTitle}"/><Border Style="{StaticResource Badge}" HorizontalAlignment="Right"><TextBlock Text="{Binding Capture.SelectedTranslationMode}" Style="{StaticResource Caption}" FontSize="10"/></Border></DockPanel>
     <TextBlock Text="翻译模式" Style="{StaticResource Caption}"/>
     <ComboBox ItemsSource="{Binding Capture.TranslationProviders}" SelectedItem="{Binding Capture.SelectedTranslationProvider,Mode=TwoWay}" Margin="0,6,0,12" AutomationProperties.AutomationId="SettingsTranslationMode"/>
     <TextBlock Text="DeepSeek 模型" Style="{StaticResource Caption}"/>
     <ComboBox ItemsSource="{Binding Capture.DeepSeekModels}" SelectedItem="{Binding Capture.SelectedDeepSeekModel,Mode=TwoWay}" IsEnabled="{Binding Capture.IsDeepSeekProvider}" Margin="0,6,0,12" AutomationProperties.AutomationId="DeepSeekModel"/>
     <TextBlock Text="翻译风格" Style="{StaticResource Caption}"/>
     <ComboBox ItemsSource="{Binding Capture.AiStyles}" SelectedItem="{Binding Capture.SelectedAiStyle}" Margin="0,6,0,14"/>

     <TextBlock Text="DeepL API Key" Style="{StaticResource Caption}"/>
     <PasswordBox local:PasswordBoxBinding.BindPassword="True" local:PasswordBoxBinding.BoundPassword="{Binding Capture.DeepLApiKeyInput,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,7"/>
     <TextBlock Text="{Binding Capture.DeepLTranslationStatus}" Style="{StaticResource Caption}" Margin="0,0,0,7"/>
     <WrapPanel Margin="0,0,0,12"><Button Content="保存 DeepL 密钥" Command="{Binding Capture.SaveDeepLKeyCommand}" Margin="0,0,8,6"/><Button Content="删除" Command="{Binding Capture.DeleteDeepLKeyCommand}" Margin="0,0,0,6"/></WrapPanel>

     <TextBlock Text="DeepSeek API Key" Style="{StaticResource Caption}"/>
     <PasswordBox local:PasswordBoxBinding.BindPassword="True" local:PasswordBoxBinding.BoundPassword="{Binding Capture.AiApiKeyInput,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,7"/>
     <TextBlock Text="{Binding Capture.AiTranslationStatus}" Style="{StaticResource Caption}" Margin="0,0,0,7"/>
     <WrapPanel Margin="0,0,0,8"><Button Content="保存 DeepSeek 密钥" Command="{Binding Capture.SaveAiKeyCommand}" Margin="0,0,8,6"/><Button Content="删除" Command="{Binding Capture.DeleteAiKeyCommand}" Margin="0,0,0,6"/></WrapPanel>
     <Button Content="测试当前翻译模式" Command="{Binding Capture.TestAiConnectionCommand}" HorizontalAlignment="Left"/>
     <TextBlock Text="{Binding Capture.ActiveTranslationStatus}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,9,0,0"/>
    </StackPanel>
   </Border>

   <Border Grid.Row="6" Style="{StaticResource CardStyle}">
    <StackPanel><TextBlock Text="快捷键" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/><DockPanel><TextBlock Text="开始 / 暂停识别"/><TextBlock Text="Ctrl + Shift + T" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="即将支持，当前未注册全局快捷键。" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel>
   </Border>

   <Border Grid.Row="6" Grid.Column="2" Style="{StaticResource CardStyle}">
    <StackPanel><TextBlock Text="开发者" Style="{StaticResource SectionTitle}" Margin="0,0,0,18"/><CheckBox Content="显示高级诊断内容" IsChecked="{Binding Capture.DebugMode}"/><CheckBox Content="显示搜索区域（黄色）" IsChecked="{Binding Capture.ShowSearchRegion}"/><CheckBox Content="显示候选区域（灰色）" IsChecked="{Binding Capture.ShowCandidates}"/><CheckBox Content="显示候选评分" IsChecked="{Binding Capture.ShowCandidateScore}"/><CheckBox Content="显示稳定区域（绿色）" IsChecked="{Binding Capture.ShowStableRegion}"/><CheckBox Content="显示窗口与视觉诊断" IsChecked="{Binding Capture.ShowWindowInformation}"/><Button Content="打开日志目录" Command="{Binding Capture.OpenLogsCommand}" HorizontalAlignment="Left" Margin="0,15,0,0"/></StackPanel>
   </Border>
  </Grid>
 </StackPanel>
</UserControl>
