<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="AccentColor">#4778E8</Color>
  <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentHover" Color="#3768D8"/>
  <SolidColorBrush x:Key="AccentPressed" Color="#2857BD"/>
  <SolidColorBrush x:Key="AccentSoft" Color="#EAF1FF"/>
  <SolidColorBrush x:Key="Canvas" Color="#F5F7FB"/>
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Sidebar" Color="#FBFCFE"/>
  <SolidColorBrush x:Key="Text" Color="#25324B"/>
  <SolidColorBrush x:Key="Muted" Color="#768298"/>
  <SolidColorBrush x:Key="Line" Color="#E8EDF5"/>
  <SolidColorBrush x:Key="Hover" Color="#F0F3F8"/>
  <SolidColorBrush x:Key="Success" Color="#24866A"/>
  <SolidColorBrush x:Key="SuccessSoft" Color="#EAF7F0"/>
  <SolidColorBrush x:Key="Warning" Color="#AD7426"/>
  <SolidColorBrush x:Key="WarningSoft" Color="#FFF4E5"/>
  <SolidColorBrush x:Key="Error" Color="#C55454"/>
  <SolidColorBrush x:Key="ErrorSoft" Color="#FDEEEE"/>
  <SolidColorBrush x:Key="PreviewCanvas" Color="#EDF2F8"/>
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>
  <LinearGradientBrush x:Key="HeroBackground" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0"/><GradientStop Color="#EFF5FF" Offset="1"/></LinearGradientBrush>
  <FontFamily x:Key="BodyFont">Segoe UI Variable, Segoe UI, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <DropShadowEffect x:Key="CardShadow" Color="#7891B4" BlurRadius="14" ShadowDepth="2" Opacity="0.05"/>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="BodyMuted" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="27"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Icon" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="19"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="NoWrap"/></Style>
  <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="22"/><Setter Property="Effect" Value="{StaticResource CardShadow}"/></Style>
  <Style x:Key="Badge" TargetType="Border"><Setter Property="Background" Value="{StaticResource Hover}"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="8,4"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,11"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Hover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Foreground" Value="{StaticResource Surface}"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="{StaticResource AccentPressed}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Text}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Foreground" Value="{StaticResource Error}"/><Setter Property="Background" Value="{StaticResource ErrorSoft}"/></Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"><Setter Property="Padding" Value="12,9"/><Setter Property="Background" Value="{StaticResource TransparentBrush}"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="38"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Background" Value="{StaticResource Surface}"/></Style>
  <Style x:Key="OffToggle" TargetType="CheckBox"><Setter Property="IsEnabled" Value="False"/><Setter Property="IsChecked" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border Width="38" Height="21" CornerRadius="11" Background="{StaticResource Line}" Margin="0,0,10,0"><Ellipse Width="15" Height="15" Fill="{StaticResource Surface}" HorizontalAlignment="Left" Margin="3"/></Border><TextBlock Text="关闭" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="NavItem" TargetType="ListBoxItem"><Setter Property="Margin" Value="10,3"/><Setter Property="Padding" Value="15,13"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Item" CornerRadius="9" Background="{StaticResource TransparentBrush}"><Grid><Border x:Name="Indicator" Width="3" Height="21" CornerRadius="2" Background="{StaticResource Accent}" HorizontalAlignment="Left" Visibility="Collapsed"/><ContentPresenter Margin="{TemplateBinding Padding}"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource Hover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{StaticResource AccentSoft}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Item" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="StatusCapsule" TargetType="Border" BasedOn="{StaticResource Badge}"><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="13,7"/><Setter Property="TextElement.Foreground" Value="{StaticResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding StateTone}" Value="Running"><Setter Property="Background" Value="{StaticResource SuccessSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource Success}"/></DataTrigger><DataTrigger Binding="{Binding StateTone}" Value="Paused"><Setter Property="Background" Value="{StaticResource WarningSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource Warning}"/></DataTrigger><DataTrigger Binding="{Binding StateTone}" Value="Faulted"><Setter Property="Background" Value="{StaticResource ErrorSoft}"/><Setter Property="TextElement.Foreground" Value="{StaticResource Error}"/></DataTrigger></Style.Triggers></Style>
<SolidColorBrush x:Key="VisionStable" Color="#16B85E"/><SolidColorBrush x:Key="VisionSearch" Color="#DBAC19"/><SolidColorBrush x:Key="VisionCandidate" Color="#8896A5"/></ResourceDictionary>

