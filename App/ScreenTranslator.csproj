<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Version>0.3.11</Version>
    <AssemblyName>ScreenTranslator</AssemblyName>
    <AssemblyTitle>屏幕翻译器</AssemblyTitle>
    <Product>屏幕翻译器</Product>
    <ApplicationIcon>Assets\ScreenTranslator.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\ScreenTranslator.ico" />
    <InternalsVisibleTo Include="ScreenTranslator.Tests" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.13.0.20260627" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <Compile Include="..\Vision\**\*.cs" />
    <Compile Include="..\Core\**\*.cs;..\Capture\**\*.cs;..\Services\**\*.cs;..\Utils\**\*.cs;..\Models\**\*.cs;..\OCR\**\*.cs;..\Translation\**\*.cs;..\Overlay\**\*.cs;..\Recognition\**\*.cs;..\Document\**\*.cs" />
    <Content Include="..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ModelsData\Translation\**\*" Link="ModelsData\Translation\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ModelsData\Fonts\**\*" Link="ModelsData\Fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ModelsData\OCR\PP-OCRv5_server_det\inference.*" Link="ModelsData\OCR\PP-OCRv5_server_det\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ModelsData\OCR\en_PP-OCRv5_mobile_rec\inference.*;..\ModelsData\OCR\en_PP-OCRv5_mobile_rec\characters.json" Link="ModelsData\OCR\en_PP-OCRv5_mobile_rec\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ModelsData\OCR\LICENSE.txt;..\ModelsData\OCR\metadata.json" Link="ModelsData\OCR\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ThirdPartyNotices.md" Link="ThirdPartyNotices.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
